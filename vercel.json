{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/canvas-view.html" },
    { "source": "/support.js", "destination": "/runtime/artifact-type/dc-runtime.js" },
    { "source": "/_blob/1ac7da4f2947094995f1ad52291bf36c", "destination": "/mp-scroll.js" },
    { "source": "/:path*", "destination": "/mes-powder-canvas/project/:path*" }
  ],
  "headers": [
    {
      "source": "/_blob/:id",
      "headers": [{ "key": "Content-Type", "value": "text/javascript; charset=utf-8" }]
    },
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
